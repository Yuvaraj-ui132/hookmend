MONGODB_URI=mongodb://localhost:27017/hookmend?directConnection=true
PORT=3000
NODE_ENV=development
MAX_BODY_SIZE=524288
TIMESTAMP_TOLERANCE_SECONDS=300
INGEST_RATE_LIMIT_MAX=100
INGEST_RATE_LIMIT_WINDOW_MS=60000
EVENT_TTL_DAYS=14
LOG_LEVEL=info
GITHUB_WEBHOOK_SECRET=change-me
SIM_WEBHOOK_SECRET=change-me

# Phase 2 Queue & Worker Config
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=hookmend
WORKER_CONCURRENCY=5
PROCESS_EVENT_ATTEMPTS=5
PROCESS_EVENT_BACKOFF_BASE_MS=1000
PROCESS_EVENT_BACKOFF_MAX_MS=30000
DOWNSTREAM_TIMEOUT_MS=10000
RECONCILE_INTERVAL_MS=300000
RECONCILE_MIN_AGE_MS=60000
RECONCILE_BATCH=500
ADMIN_API_TOKEN=change-me

# Phase 3A AI & Proposals Config
ENABLE_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_RPM_LIMIT=10
GEMINI_RPD_LIMIT=100
MAX_SCHEMA_BYTES=102400
REPLAY_MAX_EVENTS=1000

# Phase 3B SSE, CORS, Simulator (D42)
SSE_HEARTBEAT_MS=25000
MAX_SSE_CLIENTS=20
DASHBOARD_ORIGINS=http://localhost:5173
ENABLE_SIMULATOR_API=false
SIMULATOR_SOURCES=sim-payments
ALLOW_PRIVATE_DOWNSTREAM=false

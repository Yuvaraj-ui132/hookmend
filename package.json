{
  "name": "hookmend",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "exit-test:phase1": "node packages/api/scripts/exit-test.js",
    "exit-test:phase2": "node packages/worker/scripts/exit-test-phase2.js",
    "exit-test:phase3a": "node packages/worker/scripts/exit-test-phase3a.js",
    "exit-test:phase3b": "node packages/api/scripts/exit-test-phase3b.js",
    "exit-test:phase4": "node packages/worker/scripts/exit-test-phase4.js",
    "chaos": "node packages/worker/scripts/chaos.js",
    "load-test": "node packages/worker/scripts/load-test.js",
    "seed": "node infra/seed/seed.js",
    "dev": "npm run dev --workspace=packages/api",
    "dev:dashboard": "npm run dev --workspace=packages/dashboard",
    "build:dashboard": "npm run build --workspace=packages/dashboard"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "bullmq": "^6.3.17",
    "ioredis": "^6.0.0"
  }
}
